{
  "name": "lambda-handler-tester",
  "version": "0.2.7",
  "description": "A command line tool to test AWS Lambda handler local",
  "type": "module",
  "files": [
    "dist/**/*",
    "!dist/cli.js.map",
    "bin/**/*"
  ],
  "bin": {
    "lambda-handler-tester": "./bin/index.js"
  },
  "scripts": {
    "start": "NODE_NO_WARNINGS=1 node --experimental-strip-types  src/cli.ts $@",
    "start:dist": "node ./dist/cli.js",
    "build": "tsdown",
    "clean": "rm -rf ./dist/",
    "cm": "cz",
    "semantic-release": "semantic-release",
    "test:watch": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "tsdown": {
    "format": [
      "esm"
    ],
    "entry": [
      "src/cli.ts"
    ],
    "splitting": false,
    "sourcemap": false,
    "clean": true
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:aheissenberger/lambda-handler-tester.git"
  },
  "license": "bsd-2-clause",
  "author": {
    "name": "Andreas Heissenberger",
    "email": "andreas@heissenberger.at",
    "url": "https://github.com/aheissenberger"
  },
  "engines": {
    "node": ">=20.0",
    "pnpm": ">=10"
  },
  "keywords": [
    "aws",
    "lambda",
    "testing",
    "waku",
    "vike",
    "react-server"
  ],
  "bugs": {
    "url": "https://github.com/aheissenberger/lambda-handler-tester/issues"
  },
  "homepage": "https://github.com/aheissenberger/lambda-handler-tester#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "easy-table": "^1.2.0",
    "pretty-ms": "^9.3.0",
    "summary": "^2.1.0"
  },
  "devDependencies": {
    "@hattip/adapter-aws-lambda": "^0.0.49",
    "@ryansonshine/commitizen": "^4.2.8",
    "@ryansonshine/cz-conventional-changelog": "^3.3.4",
    "@types/aws-lambda": "^8.10.157",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.0.6",
    "bump": "^0.2.5",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "execa": "^9.6.0",
    "husky": "^9.1.7",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.1",
    "streaming": "link:@hattip/adapter-aws-lambda/streaming",
    "tsdown": "^0.15.12",
    "vitest": "^4.0.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@ryansonshine/cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "build",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "build",
                "section": "Dependencies and Other Build Updates",
                "hidden": false
              }
            ]
          }
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@10.20.0"
}